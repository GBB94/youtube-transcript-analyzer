# Phase 1 needs none of these (offline, uploaded_file only).
# Acquisition (the pull half):
# YOUTUBE_API_KEY=            # Phase 6 discovery (dual-bucket quota; see DESIGN.md §8)
# MANAGED_API_KEY=            # Phase 5 managed provider (native captions / ASR)
# MANAGED_API_BASE_URL=       # Phase 5 provider endpoint (defaults in strategies/managed.py)
# WHISPER_MODEL=small         # Phase 4 (pin a revision in code)
# WHISPER_COMPUTE_TYPE=int8
# TRANSCRIPT_CACHE_DIR=~/.cache/transcript-tool
# Retrieval (the ask half) — each of these is EGRESS and optional; the
# --embedder local --no-context path needs none of them:
# ANTHROPIC_API_KEY=          # R4 contextual blurbs + R5 grounded answering ('answer' extra)
# VOYAGE_API_KEY=             # optional API embedder upgrade ('embed_api' extra)
# HF_TOKEN=                   # R7 pyannote diarization pipeline download ('diarize' extra)
# Cookies are opt-in only and never auto-read; pass an explicit, dedicated file.
